POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWS_API_KEY=

# Market-wide Cup & Handle scanner. The defaults are conservative for a
# single Render instance; raise concurrency only after monitoring 429 rates.
SCANNER_SPARK_CONCURRENCY=4
SCANNER_VALIDATION_CONCURRENCY=5
SCANNER_FETCH_TIMEOUT_MS=15000
SCANNER_RESULT_TTL_MS=1800000
SCANNER_MIN_VALIDATIONS=120
