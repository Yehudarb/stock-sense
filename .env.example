POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
NEWS_API_KEY=

# S&P 500 Cup & Handle scanner. Membership verification fails closed.
SP500_CONSTITUENTS_URL=https://raw.githubusercontent.com/datasets/s-and-p-500-companies/main/data/constituents.csv

# The defaults are conservative for a single Render instance; raise
# concurrency only after monitoring upstream 429 rates.
SCANNER_SPARK_CONCURRENCY=4
SCANNER_VALIDATION_CONCURRENCY=5
SCANNER_FETCH_TIMEOUT_MS=15000
SCANNER_RESULT_TTL_MS=1800000
